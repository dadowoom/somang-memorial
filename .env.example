# 소망교회 온라인 추모관 — 환경설정 예시
#
# 이 파일을 .env 로 복사한 뒤 값을 채웁니다.
#   cp .env.example .env
#
# ⚠️ 실제 비밀값은 이 파일에 적지 않습니다. .env 만 서버에 두고,
#    .env 는 git 에 올라가지 않습니다(.gitignore 등록됨).

# ── 반드시 있어야 서버가 뜹니다 ──────────────────────────────

# 데이터베이스 접속 주소
DATABASE_URL=mysql://사용자:비밀번호@127.0.0.1:3306/데이터베이스이름

# 로그인 상태를 서명하는 열쇠. 아래 명령으로 만들어 붙여넣습니다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 이 값이 바뀌면 모든 회원이 로그아웃됩니다.
JWT_SECRET=

# ── 기본값이 있어 비워도 됩니다 ──────────────────────────────

NODE_ENV=development
PORT=5100

# 업로드된 사진을 저장할 폴더.
# 운영 기본값은 /var/www/somang-memorial/uploads 입니다.
UPLOAD_DIR=

# 사이트 주소. 문자 메시지에 넣는 링크를 만들 때 씁니다.
PUBLIC_SITE_URL=http://localhost:5100

# 리버스 프록시(nginx) 뒤에 있을 때만 true.
# true 로 두면 x-forwarded-proto 헤더를 신뢰합니다. HTTPS 전환 시 필요합니다.
TRUST_PROXY=false

# ── 문자 알림 (SOLAPI) ───────────────────────────────────────
# ⚠️ 발송할 때마다 실제 요금이 나갑니다. 개발 중에는 반드시 꺼 두십시오.

REMINDER_SCHEDULER_ENABLED=false
REMINDER_DAYS_BEFORE=1
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_FROM_NUMBER=

# ── 외부 로그인(OAuth) ───────────────────────────────────────
# 자체 가입·로그인만 쓸 거라면 비워도 됩니다.
# 비어 있으면 시작할 때 경고가 뜨지만 서버는 정상 동작합니다.

OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# ── 그 외 ────────────────────────────────────────────────────

# 김소망 권사 가족관에 넣을 유튜브 영상 ID (11자). 비우면 영상이 안 보입니다.
KIM_SOMANG_FAMILY_VIDEO_ID=

BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
